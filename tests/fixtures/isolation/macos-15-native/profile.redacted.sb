(version 1)
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read-metadata (vnode-type DIRECTORY))
(allow file-read* (literal "/") (subpath "/System/Library") (subpath "/usr/lib") (subpath "/usr/share/icu") (subpath "/usr/bin") (subpath "/bin"))
(allow file-read* (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom"))
(allow file-read* (subpath "<STAND>/worktree") (subpath "<STAND>/runtime") (literal "<STAND>/descendant"))
(allow file-write* (subpath "<STAND>/runtime"))
(deny file-write* (subpath "<STAND>/worktree") (subpath "<STAND>/outside") (subpath "<STAND>/common-git"))
(allow network-outbound (remote ip "localhost:62277"))