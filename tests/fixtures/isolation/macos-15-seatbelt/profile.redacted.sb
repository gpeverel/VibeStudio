(version 1)
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read-metadata (vnode-type DIRECTORY))
(allow file-read* (literal "/") (subpath "/System/Library") (subpath "/usr/lib") (subpath "/usr/bin") (subpath "/bin"))
(allow file-read* (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random"))
(allow file-read* (subpath "<STAND>/worktree") (subpath "<STAND>/runtime"))
(allow file-write* (subpath "<STAND>/runtime"))
(deny file-write* (subpath "<STAND>/outside") (subpath "<STAND>/main/.git") (subpath "<STAND>/worktree"))
(allow network-outbound (remote ip "localhost:56938"))